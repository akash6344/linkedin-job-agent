{
  "name": "letitapply-companion",
  "version": "0.1.0",
  "description": "LetItApply Companion — LinkedIn search on your laptop",
  "main": "main.js",
  "author": "LetItApply",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.letitapply.companion",
    "productName": "LetItApply Companion",
    "directories": { "output": "dist" },
    "mac": { "category": "public.app-category.productivity", "target": ["dmg"] },
    "win": { "target": ["nsis"] }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
